{% extends 'base_template.html.twig' %}

{% block title %}Créer un compte - SHARE{% endblock %}

{% block content %}
    <main class="row justify-content-center py-4">
        <div class="col-md-8 col-lg-6">
            <h1 class="mb-4">Créer un compte</h1>

            {% if succes %}
                <div class="alert alert-success" role="status">
                    Votre compte a été créé avec succès.
                </div>
            {% else %}
                {% if erreurs %}
                    <div class="alert alert-danger" role="alert">
                        <p class="mb-2">L’inscription n’a pas pu être effectuée :</p>
                        <ul class="mb-0">
                            {% for erreur in erreurs %}
                                <li>{{ erreur }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <p>Les champs marqués d’un astérisque sont obligatoires.</p>
                <form action="index.php?controleur=compte&amp;methode=traiterFormulaireInscription" method="post">
                    {% set champs = [
                        {nom: 'pseudo', libelle: 'Pseudo', type: 'text', longueur: 50, obligatoire: true, autocomplete: 'username'},
                        {nom: 'prenom', libelle: 'Prénom', type: 'text', longueur: 50, obligatoire: true, autocomplete: 'given-name'},
                        {nom: 'nom', libelle: 'Nom', type: 'text', longueur: 50, obligatoire: true, autocomplete: 'family-name'},
                        {nom: 'adresse_mail', libelle: 'Adresse e-mail', type: 'email', longueur: 50, obligatoire: true, autocomplete: 'email'},
                        {nom: 'telephone', libelle: 'Téléphone', type: 'tel', longueur: 30, obligatoire: false, autocomplete: 'tel'},
                        {nom: 'date_naissance', libelle: 'Date de naissance', type: 'date', longueur: 10, obligatoire: true, autocomplete: 'bday'},
                        {nom: 'adresse', libelle: 'Adresse postale', type: 'text', longueur: 250, obligatoire: false, autocomplete: 'street-address'}
                    ] %}
                    {% for champ in champs %}
                        <div class="mb-3">
                            <label class="form-label" for="{{ champ.nom }}">{{ champ.libelle }}{% if champ.obligatoire %} *{% endif %}</label>
                            <input class="form-control{% if erreurs[champ.nom] is defined %} is-invalid{% endif %}"
                                   type="{{ champ.type }}" id="{{ champ.nom }}" name="{{ champ.nom }}"
                                   value="{{ valeurs[champ.nom]|default('') }}"
                                   maxlength="{{ champ.longueur }}" autocomplete="{{ champ.autocomplete }}"
                                   {% if champ.type == 'email' %}pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}" title="Saisissez une adresse e-mail valide, par exemple nom@exemple.fr."{% endif %}
                                   {% if champ.type == 'date' %}min="1000-01-01" max="{{ 'now'|date('Y-m-d') }}"{% endif %}
                                   {% if champ.obligatoire %}required{% endif %}
                                   {% if erreurs[champ.nom] is defined %}aria-invalid="true" aria-describedby="erreur_{{ champ.nom }}"{% endif %}>
                            {% if erreurs[champ.nom] is defined %}
                                <div class="invalid-feedback" id="erreur_{{ champ.nom }}">{{ erreurs[champ.nom] }}</div>
                            {% endif %}
                        </div>
                    {% endfor %}

                    <div class="mb-3">
                        <label class="form-label" for="mdp">Mot de passe *</label>
                        <input class="form-control{% if erreurs.mdp is defined %} is-invalid{% endif %}"
                               type="password" id="mdp" name="mdp" minlength="8" autocomplete="new-password" required
                               pattern="(?=.*\p{Lu})(?=.*\p{Ll})(?=.*[0-9])(?=.*[^\p{L}\p{N}\s])[\s\S]{8,}"
                               title="Au moins 8 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial."
                               aria-describedby="aide_mdp{% if erreurs.mdp is defined %} erreur_mdp{% endif %}"
                               {% if erreurs.mdp is defined %}aria-invalid="true"{% endif %}>
                        <div class="form-text" id="aide_mdp">Au moins 8 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial.</div>
                        {% if erreurs.mdp is defined %}
                            <div class="invalid-feedback" id="erreur_mdp">{{ erreurs.mdp }}</div>
                        {% endif %}
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="confirmation_mdp">Confirmation du mot de passe *</label>
                        <input class="form-control{% if erreurs.confirmation_mdp is defined %} is-invalid{% endif %}"
                               type="password" id="confirmation_mdp" name="confirmation_mdp"
                               minlength="8" autocomplete="new-password" required
                               {% if erreurs.confirmation_mdp is defined %}aria-invalid="true" aria-describedby="erreur_confirmation_mdp"{% endif %}>
                        {% if erreurs.confirmation_mdp is defined %}
                            <div class="invalid-feedback" id="erreur_confirmation_mdp">{{ erreurs.confirmation_mdp }}</div>
                        {% endif %}
                    </div>
                    <button class="btn btn-primary" type="submit">Créer mon compte</button>
                </form>
            {% endif %}
        </div>
    </main>
{% endblock %}
