{% extends "base_template.html.twig" %}
{% block content %}
    <div>
    <h2> Gestion des comptes</h2>
        {# formulaire permettant de bannir et debannir tous les utilisateurs via la saisie un id#}
        <div>
            <form action="index.php?controleur=compte&methode=bannir" method="POST" onsubmit="return confirm('Voulez-vous vraiment bannir cet utilisateur ?');">
                <input type="number" id="id" name="id" min="1" placeholder="Exemple: 2">
                <button type="submit">Bannir</button>
            </form>
        </div>
        <div>
            <form action="index.php?controleur=compte&methode=debannir" method="POST" onsubmit="return confirm('Voulez-vous vraiment debannir cet utilisateur ?');">
                <input type="number" id="id" name="id" min="1" placeholder="Exemple: 2">
                <button type="submit">Debannir</button>
            </form>
        </div>
    </div>
{% endblock %}