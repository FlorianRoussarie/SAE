<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="CSS/styles.css">
    {% block css %}{% endblock %}
    <title>{% block title %}SHARE{% endblock %}</title>
</head>
<body class="container">
    <header class="py-3">
        <nav class="navbar bg-body-tertiary" aria-label="Navigation principale">
            <div class="container-fluid">
                <span class="navbar-brand">SHARE</span>
                {% if session.id_compte is defined %}
                    <span class="navbar-text">Connecté : {{ session.pseudo }}</span>
                {% else %}
                    <a class="nav-link{% if menu == 'inscription' %} active{% endif %}"
                       href="index.php?controleur=compte&amp;methode=afficherFormulaireInscription">Créer un compte</a>
                    <a class="nav-link{% if menu == 'connexion' %} active{% endif %}"
                       href="index.php?controleur=compte&amp;methode=afficherFormulaireConnexion">Se connecter</a>
                {% endif %}
            </div>
        </nav>
    </header>
    {% block content %}{% endblock %}
    {% block script %}{% endblock %}
</body>
</html>
