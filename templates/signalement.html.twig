{% extends 'base_template.html.twig' %}
    {% block title %}Signalement n°{{signalement.id}} - SHARE{% endblock %}

    {% block content %}
        <main>
            <h1>Signalement n°{{signalement.id}}</h1>
    <!--                Affichage de la description de la recette et de l'image-->
            <div class="row">
                <div class="col-md-9">
                    <h2>Effectué le {{ signalement.date|date('d/m/Y H:i')}} par {{ signalement.pseudo_auteur }}</h2><br>
                    <h2>Utilisateur signalé: {{ signalement.pseudo_cible }}</h2><br><br>
                    <h3>Vidéo: {% if signalement.id_video != null %} {{signalement.titre_video}} {% else %} Aucune vidéo liée {% endif %}</h3><br><br>
                    <h3>raison du signalement: {{ signalement.raison }}</h3><br><br>
                    <button>Signaler</button>
                    <button>Bannir</button>
                    <button>Ignorer</button>
                    {% if signalement.id_video != null %}
                        <form method="post" action="index.php?controleur=video&methode=supprimer" onsubmit="return confirm('Supprimer cette vidéo ?');">
                            <input type="hidden" name="id_video" value="{{ signalement.id_video }}">
                            <input type="hidden" name="id_signalement" value="{{ signalement.id }}">
                            <input type="hidden" name="csrf_suppression" value="{{ jetonSuppression }}">
                            <button type="submit">Supprimer la vidéo</button>
                        </form>
                    {% endif %}
                </div>            
            </div>            
        </main>
    {% endblock %}